{
  "name": "devconnector",
  "version": "1.0.0",
  "description": "Practice with MERN Front To Back: Full Stack React, Redux & Node.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node --watch server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "heroku-postbuild": "npm install --prefix client && npm run build --prefix client"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/binjuhor/devconnector.git"
  },
  "keywords": [
    "nodejs",
    "node",
    "app",
    "structure"
  ],
  "author": "Kiem Hoang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/binjuhor/devconnector/issues"
  },
  "homepage": "https://github.com/binjuhor/devconnector#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "config": "^5.0.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "gravatar": "^1.8.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "engines": {
    "node": ">=26"
  }
}
